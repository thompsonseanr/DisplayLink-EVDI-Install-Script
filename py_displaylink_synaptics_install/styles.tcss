Header {
    height: 1;
    align: center middle;
    dock: top;
}

Footer {
    height: 1;
    align: left middle;
    dock: bottom;
}

RichLog {
    height: 1fr;
    padding: 1 2;
    border: tall $primary;
    background: #000000;
}

ListView {
    margin: 2;
}

ListItem {
    padding: 1;
}

/*
NoConnectionModal
*/

NoConnectionModal {
    align: center middle;
}

/*
InstallModal
*/

InstallModal {
    align: center middle;
}

#install-dialog {
    align: center middle;
    width: 80;
    height: 30;
    background: $surface;
    border: tall $primary;
    padding: 1 2;
}

#horizontal-inst-btn {
    layout: grid;
    grid-size: 2;
    height: auto;
    margin-top: 2;
    align: center middle;
    border: solid #d8dee9;
}

Button.dialog-q-btn {
    color: #2e3440;
    background: #5e81ac;
    text-style: none;
}

Button.dialog-q-btn:focus, .dialog-q-btn:hover {
    color: #d8dee9;
    background: #bf616a;
    text-style: bold;
}


/*
UninstallDialogScreen
*/

UninstallDialogScreen {
    align: center middle;
}

#undisp-dialog {
    align: center middle;
    width: 80;
    height: 30;
    background: $surface;
    border: tall $primary;
    padding: 1 2;
}

Button.dialog-un-btn {
    color: #2e3440;
    background: #5e81ac;
    text-style: none;
}

Button.dialog-un-btn:focus, .dialog-un-btn:hover {
    color: #d8dee9;
    background: #bf616a;
    text-style: bold;
}


/*
UninstallIndicatorScreen
*/

UninstallIndicatorScreen {
    align: center middle;
}

/*
UninstallCompleteScreen
*/

UninstallCompleteScreen {
    align: center middle;
}

/*
IntroContainer
*/

IntroContainer {
    align: center middle;
}

/*
BeginInstallScreen
*/

BeginInstallScreen {
    align: center middle;
}

Button.dialog-begin-btn {
    color: #2e3440;
    background: #5e81ac;
    text-style: none;
}

Button.dialog-begin-btn:focus, .dialog-begin-btn:hover {
    color: #2e3440;
    background: #88c0d0;
    text-style: bold;
}

/*
EvdiDecisionScreen
*/

EvdiDecisionScreen {
    align: center middle;
}

/*
DownloadEvdiSoftwareScreen
*/

DownloadEvdiSoftwareScreen {
    align: center middle;
}

/*
DisplayLinkDownloadScreen
*/

DisplayLinkDownloadScreen {
    align: center middle;
}

/*
BeginDisplayLinkInstallDialogueScreen
*/

BeginDisplayLinkInstallDialogueScreen {
    align: center middle;
}

Button.dialog-install-btn {
    color: #2e3440;
    background: #5e81ac;
    text-style: none;
}

Button.dialog-install-btn:focus, .dialog-install-btn:hover {
    color: #2e3440;
    background: #88c0d0;
    text-style: bold;
}

/*
DisplayLinkInstallationScreen
*/

DisplayLinkInstallationScreen {
    align: center middle;
}

/*
CleanFilesExitScreen
*/

CleanFilesExitScreen {
    align: center middle;
}

/*
FinalizeScreen
*/

FinalizeScreen {
    align: center middle;
}

#finish-inst-message {
    align: left top;
}

/*
FinishExitScreen
*/

FinishExitScreen {
    align: center middle;
}

#horizontal-ex-btn {
    layout: grid;
    grid-size: 1;
    height: auto;
    margin-top: 2;
    align: center middle;
}

#exit-button {
    display: none;
}

Button.exit-inst-btn:focus, .exit-inst-btn:hover {
    color: #2e3440;
    background: #88c0d0;
    text-style: bold;
}