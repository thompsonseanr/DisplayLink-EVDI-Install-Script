# 	if [[ -n $evdiGitTag ]]; then
# 		git fetch --tags && git checkout -b "$evdiGitTag"
# 		tar -czvf ../evdi.tar.gz .
# 		git checkout "$evdiGitMain"
# 		git branch -d "$evdiGitTag"
# 	else
# 		printf "${RED}>>>${RESET} ${WHITE}There are no tags for this repo. Exiting.${RESET}\n" >&2
# 		exit 1
# 	fi
# else
