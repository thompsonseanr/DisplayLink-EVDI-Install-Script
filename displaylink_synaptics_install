# 	unzip "$displayLinkFullName" -d "$displayLinkFileDir"
# else
# 	printf "${RED}>>>${RESET} ${WHITE}Please download the Synaptics DisplayLink Driver and Manager: https://www.synaptics.com/products/displaylink-graphics/downloads/ubuntu{RESET}\n" >&2
# 	rm -f "${evdiTarPath}/evdi.tar.gz"
# 	exit 1
