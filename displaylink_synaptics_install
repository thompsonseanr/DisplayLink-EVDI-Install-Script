unzip_displaylink

if [[ -n $displayLinkInstallDir ]]; then
	sudo bash -s "$displayLinkFileDir" "$displayLinkInstallDir" "$locUser" <<'EOF'
		if [ -d "$2" ]; then
			rm -rf "$2"
		fi
		mv "$1" "$2"
		chown -R "$3":"$3" "$2"
EOF
else
	printf "${RED}>>>${RESET} ${WHITE}Installation target directory is missing. Exiting.{RESET}\n" >&2
	exit 1
fi

cd "$displayLinkInstallDir"

sudo bash -s "$displayLinkInstallDir" "$locUser" "$RED" "$WHITE" "$RESET" <<'EOF'
	runFile="$(find "$1" -type f -name "*.run")"
	if [[ -n $runFile ]]; then
		chmod +x "$runFile"
		"$runFile" --noexec --keep
		chown -R "$2":"$2" "$1"
	else
		printf "${3}>>>${5} ${4}No DisplayLink run file exists. Exiting.{5}\n" >&2
		exit 1
	fi
EOF

extractDir="$(find "$displayLinkInstallDir" -maxdepth 1 -type d -name "displaylink-*")"

if [[ -n $extractDir ]]; then
	cd "$extractDir"
else
	printf "${RED}>>>${RESET} ${WHITE}No extracted installation directory exists. Exiting.{RESET}\n" >&2
	exit 1
fi

sudo bash -s "$extractDir" "$evdiTarPath" "$locUser" "$displayLinkInstallDir" "$RED" "$WHITE" "$RESET" <<'EOF'
	if [ -f "$1/evdi.tar.gz" ]; then
		mv "$1/evdi.tar.gz" "$1/evdi.tar.gz.bak.$(date +%Y%m%d)"
	else
		printf "${5}>>>${7} ${6}${1}/evdi.tar.gz does not exist. Exiting.{7}\n" >&2
		exit 1
	fi	
	if [ -f "$2/evdi.tar.gz" ]; then
		mv "$2/evdi.tar.gz" "$1/"
		chown -R "$3":"$3" "$4"
		chmod +x "$1/displaylink-installer.sh"
		./displaylink-installer.sh
	else
		printf "${5}>>>${7} ${6}${2}/evdi.tar.gz does not exist. Exiting.{7}\n" >&2
		exit 1
	fi
EOF

printf "${BLUE}:::::::::::::::::::::::::::::::::::::::::::${RESET}\n"
printf "${BLUE}::${RESET} ${WHITE}DisplayLink Installer Complete${RESET}\n"
printf "${BLUE}::${RESET} ${WHITE}You will need to reboot for the EVDI kernel modules to load${RESET}\n"
printf "${BLUE}::${RESET} ${WHITE}VOID linux/runit -based distro users: Remember to remove the 'down' service file and restart the 'displaylink-driver' service:${RESET}\n"
printf "${BLUE}::${RESET} ${WHITE}cd /var/service/displaylink-driver${RESET}\n"
printf "${BLUE}::${RESET} ${WHITE}sudo mv down down.bak${RESET}\n"
